DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Optional SMTP provider. Mailpit is recommended for local testing.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BeaverLink <noreply@example.local>
# Database SSL configuration
# verify: encrypted connection with certificate validation
# disable: unencrypted connection (local development only)
DATABASE_SSL_MODE=verify

# Optional CA certificate path, relative to auth/
# Required when the provider uses a CA not trusted by the system
DATABASE_CA_CERT_PATH=certs/supabase-ca.crt